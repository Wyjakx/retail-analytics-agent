# Live-mode configuration. Offline mode needs no API credentials.
# Keep actual credentials in an ignored .env file or use local ADC.
GOOGLE_API_KEY=
GEMINI_MODEL=
GOOGLE_CLOUD_PROJECT=
BIGQUERY_DATASET=bigquery-public-data.thelook_ecommerce
# Values below are provisional per-operation budgets, not account-level quotas.
BIGQUERY_MAX_BYTES_BILLED=100000000
BIGQUERY_MAX_TURN_BYTES_BILLED=300000000
QUERY_TIMEOUT_SECONDS=30
TURN_TIMEOUT_SECONDS=120
MAX_ANALYSIS_QUERIES=3
MAX_PLAN_CORRECTIONS=1
MAX_MODEL_RETRIES=2
MIN_GROUP_CUSTOMERS=3
# Optional JSON mapping of trusted demo actor IDs to allowed product IDs.
# This is a demo policy fixture, not authentication.
PRODUCT_PERMISSIONS_FILE=
# Optional 64-character hex secret for stable actor-scoped customer pseudonyms.
# If empty, a random key is created in APP_DATA_DIR/<mode>/customer-pseudonym.key.
# Keep the key private and persistent; rotating it changes all customer labels.
CUSTOMER_PSEUDONYM_KEY=
APP_DATA_DIR=runtime
